// Spectrum Retro: oil paint (anisotropic Kuwahara), ASCII art, retro
// palettes with ordered dithering, and VHS tape. Each effect is its own
// technique; the filter chains only the enabled ones (see src/fx/retro.c).
// Every pass reads `image` through fx_input() (linear light in, sRGB
// encoded out) and writes through fx_output(), so intermediate float
// textures hold linear light, straight alpha.
#include "fx-common.effect"

// Pass inputs.
uniform texture2d tensor_tex;          // oil: smoothed structure tensor
uniform float2 pass_dir;               // tensor blur step, uv
uniform float2 pass_texel;             // 1 / size

// Oil paint
uniform float rt_oil_radius = 0.0;     // px, 0 = off
uniform float rt_oil_sharpness = 50.0; // %
uniform float rt_oil_anisotropy = 100.0; // %

// ASCII
uniform float rt_ascii = 0.0;          // %
uniform float rt_ascii_size = 10.0;    // cell width, px
uniform int rt_ascii_mode;             // 0 original colors, 1 mono, 2 custom
uniform float4 rt_ascii_color;
uniform float4 rt_ascii_bg_color;

// Palette
uniform int rt_pal_dither;             // 0 none, 1-3 Bayer 2/4/8, 4 blue noise
uniform float rt_pal_strength = 100.0; // %
uniform float rt_pal_pixel = 2.0;      // px
uniform float pal_luma = 0.0;           // 1: match brightness only (retro.c)
uniform float2 pal_lrange;             // darkest and lightest Oklab L
// Palette entries in Oklab; w = 1 when used (set by retro.c).
uniform float4 pal0;
uniform float4 pal1;
uniform float4 pal2;
uniform float4 pal3;
uniform float4 pal4;
uniform float4 pal5;
uniform float4 pal6;
uniform float4 pal7;
uniform float4 pal8;
uniform float4 pal9;
uniform float4 pal10;
uniform float4 pal11;
uniform float4 pal12;
uniform float4 pal13;
uniform float4 pal14;
uniform float4 pal15;

// VHS
uniform float rt_vhs = 0.0;            // %
uniform float rt_vhs_tracking = 40.0;  // %
uniform float rt_vhs_wobble = 1.5;     // px
uniform float rt_vhs_bleed = 6.0;      // px
uniform float rt_vhs_chroma_shift = 2.0; // px
uniform float rt_vhs_noise = 30.0;     // %
uniform float rt_vhs_head = 60.0;      // %

/* ---------------------------------------------------------------------
 * Oil paint: anisotropic Kuwahara filter with polynomial sector weights
 * (Kyprianidis et al.), steered by the smoothed structure tensor.
 * ------------------------------------------------------------------- */

float3 tensor_tap(float2 uv)
{
	return encode_input(image.Sample(textureSampler, uv)).rgb;
}

float4 PSTensor(VertData v_in) : TARGET
{
	float2 d = pass_texel;
	float2 uv = v_in.uv;
	float3 a = tensor_tap(uv + float2(-d.x, -d.y));
	float3 b = tensor_tap(uv + float2(0.0, -d.y));
	float3 c = tensor_tap(uv + float2(d.x, -d.y));
	float3 e = tensor_tap(uv + float2(-d.x, 0.0));
	float3 f = tensor_tap(uv + float2(d.x, 0.0));
	float3 g = tensor_tap(uv + float2(-d.x, d.y));
	float3 h = tensor_tap(uv + float2(0.0, d.y));
	float3 i = tensor_tap(uv + float2(d.x, d.y));
	float3 gx = (c + 2.0 * f + i - a - 2.0 * e - g) * 0.25;
	float3 gy = (g + 2.0 * h + i - a - 2.0 * b - c) * 0.25;
	return float4(dot(gx, gx), dot(gy, gy), dot(gx, gy), 1.0);
}

// Separable Gaussian (sigma 2 px) of the tensor along pass_dir.
float4 PSTensorBlur(VertData v_in) : TARGET
{
	float4 sum = float4(0.0, 0.0, 0.0, 0.0);
	float wsum = 0.0;
	for (int k = -6; k <= 6; k++) {
		float fk = float(k);
		float w = exp(-fk * fk / 8.0);
		sum += tensor_tex.Sample(textureSampler, v_in.uv + pass_dir * fk) * w;
		wsum += w;
	}
	return sum / wsum;
}

float4 oil_tap(float2 uv)
{
	return encode_input(image.SampleLevel(textureSampler, uv, 0.0));
}

// A sector's mean color and scaled variance (huge when empty).
float4 oil_sector(float4 m, float3 s, float k)
{
	if (m.w <= 1e-8)
		return float4(0.0, 0.0, 0.0, 1e30);
	float3 mean = m.rgb / m.w;
	float3 var = abs(s / m.w - mean * mean);
	return float4(mean, k * (var.r + var.g + var.b));
}

float4 oil_weight(float4 r, float sc, float base, float p)
{
	if (r.w >= 1e20)
		return float4(0.0, 0.0, 0.0, 0.0);
	float w = 1.0 / (base + pow(r.w / sc, p));
	return float4(r.rgb * w, w);
}

float4 PSOil(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float4 centre = fx_input(uv);
	float radius = max(rt_oil_radius, 1.0);

	// Local orientation and anisotropy from the structure tensor.
	float A = 0.0;
	float phi = 0.0;
	if (rt_oil_anisotropy > 0.0) {
		float3 g = tensor_tex.Sample(textureSampler, uv).xyz;
		float E = g.x;
		float G = g.y;
		float F = g.z;
		float root = sqrt((E - G) * (E - G) + 4.0 * F * F);
		float l1 = 0.5 * (E + G + root);
		float l2 = 0.5 * (E + G - root);
		float2 t = float2(l1 - E, -F);
		float tl = length(t);
		t = tl > 1e-8 ? t / tl : float2(0.0, 1.0);
		phi = -atan2(t.y, t.x);
		A = (l1 + l2 > 1e-8) ? (l1 - l2) / (l1 + l2) : 0.0;
		A *= rt_oil_anisotropy / 100.0;
	}
	float a = radius * clamp(1.0 + A, 0.1, 2.0);
	float b = radius * clamp(1.0 / (1.0 + A), 0.1, 2.0);
	float cp = cos(phi);
	float sp = sin(phi);
	float max_x = floor(sqrt(a * a * cp * cp + b * b * sp * sp));
	float max_y = floor(sqrt(a * a * sp * sp + b * b * cp * cp));
	// Large radii are sampled sparsely to bound the cost (bilinear taps
	// fill the gaps).
	float stride = max(1.0, floor(radius / 8.0));
	max_x = floor(max_x / stride) * stride;
	max_y = floor(max_y / stride) * stride;

	float s = saturate(rt_oil_sharpness / 100.0);
	float q = 2.0 + 12.0 * s;
	float hardness = 8.0 * pow(4.0, (s - 0.5) * 2.0);
	float zeta = 2.0 / radius;
	float zero_cross = 0.58;
	float sz = sin(zero_cross);
	float eta = (zeta + cos(zero_cross)) / (sz * sz);

	float4 m0 = float4(0.0, 0.0, 0.0, 0.0);
	float4 m1 = m0;
	float4 m2 = m0;
	float4 m3 = m0;
	float4 m4 = m0;
	float4 m5 = m0;
	float4 m6 = m0;
	float4 m7 = m0;
	float3 s0 = float3(0.0, 0.0, 0.0);
	float3 s1 = s0;
	float3 s2 = s0;
	float3 s3 = s0;
	float3 s4 = s0;
	float3 s5 = s0;
	float3 s6 = s0;
	float3 s7 = s0;

	float2 texel = 1.0 / uv_size;
	for (float y = -max_y; y <= max_y; y += stride) {
		for (float x = -max_x; x <= max_x; x += stride) {
			float2 v = float2((cp * x - sp * y) * 0.5 / a, (sp * x + cp * y) * 0.5 / b);
			float vv = dot(v, v);
			if (vv <= 0.25) {
				float4 tap = oil_tap(uv + float2(x, y) * texel);
				float3 c = saturate(tap.rgb);
				float vxx = zeta - eta * v.x * v.x;
				float vyy = zeta - eta * v.y * v.y;
				float z = max(0.0, v.y + vxx);
				float w0 = z * z;
				z = max(0.0, -v.x + vyy);
				float w2 = z * z;
				z = max(0.0, -v.y + vxx);
				float w4 = z * z;
				z = max(0.0, v.x + vyy);
				float w6 = z * z;
				float2 r = 0.70710678 * float2(v.x - v.y, v.x + v.y);
				vxx = zeta - eta * r.x * r.x;
				vyy = zeta - eta * r.y * r.y;
				z = max(0.0, r.y + vxx);
				float w1 = z * z;
				z = max(0.0, -r.x + vyy);
				float w3 = z * z;
				z = max(0.0, -r.y + vxx);
				float w5 = z * z;
				z = max(0.0, r.x + vyy);
				float w7 = z * z;
				float sum = w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7;
				// Transparent taps carry no color.
				float gw = exp(-3.125 * vv) / max(sum, 1e-8) * saturate(tap.a);
				float3 cc = c * c;
				m0 += float4(c, 1.0) * (w0 * gw);
				s0 += cc * (w0 * gw);
				m1 += float4(c, 1.0) * (w1 * gw);
				s1 += cc * (w1 * gw);
				m2 += float4(c, 1.0) * (w2 * gw);
				s2 += cc * (w2 * gw);
				m3 += float4(c, 1.0) * (w3 * gw);
				s3 += cc * (w3 * gw);
				m4 += float4(c, 1.0) * (w4 * gw);
				s4 += cc * (w4 * gw);
				m5 += float4(c, 1.0) * (w5 * gw);
				s5 += cc * (w5 * gw);
				m6 += float4(c, 1.0) * (w6 * gw);
				s6 += cc * (w6 * gw);
				m7 += float4(c, 1.0) * (w7 * gw);
				s7 += cc * (w7 * gw);
			}
		}
	}

	// Each sector's mean, weighted down by its variance: w = 1 / (1 + x^p),
	// evaluated relative to the smoothest sector so it never underflows.
	float p = 0.5 * q;
	float k = hardness * 1000.0;
	float4 r0 = oil_sector(m0, s0, k);
	float4 r1 = oil_sector(m1, s1, k);
	float4 r2 = oil_sector(m2, s2, k);
	float4 r3 = oil_sector(m3, s3, k);
	float4 r4 = oil_sector(m4, s4, k);
	float4 r5 = oil_sector(m5, s5, k);
	float4 r6 = oil_sector(m6, s6, k);
	float4 r7 = oil_sector(m7, s7, k);
	float xmin = min(min(min(r0.w, r1.w), min(r2.w, r3.w)), min(min(r4.w, r5.w), min(r6.w, r7.w)));
	if (xmin >= 1e20)
		return fx_output(centre, v_in.uv);
	float sc = max(xmin, 1.0);
	float base = pow(1.0 / sc, p);
	float4 o = float4(0.0, 0.0, 0.0, 0.0);
	o += oil_weight(r0, sc, base, p);
	o += oil_weight(r1, sc, base, p);
	o += oil_weight(r2, sc, base, p);
	o += oil_weight(r3, sc, base, p);
	o += oil_weight(r4, sc, base, p);
	o += oil_weight(r5, sc, base, p);
	o += oil_weight(r6, sc, base, p);
	o += oil_weight(r7, sc, base, p);
	float3 rgb = o.rgb / max(o.w, 1e-8);
	return fx_output(float4(saturate(rgb), centre.a), v_in.uv);
}

/* ---------------------------------------------------------------------
 * ASCII art: each cell becomes the glyph whose ink coverage matches the
 * cell's brightness. Glyphs are 5x7 bitmaps in a 6x8 box, stored as two
 * integers (rows 0-3 and rows 4-6, 5 bits per row) exact in float.
 * ------------------------------------------------------------------- */

#define GLYPH_COUNT 14.0

// Ramp: " .-:+=o%eO8M#@", ordered by ink coverage.
float2 glyph_bits(int i)
{
	if (i <= 0)
		return float2(0.0, 0.0); // ' '
	if (i == 1)
		return float2(0.0, 6336.0); // '.'
	if (i == 2)
		return float2(1015808.0, 0.0); // '-'
	if (i == 3)
		return float2(6336.0, 198.0); // ':'
	if (i == 4)
		return float2(1020032.0, 132.0); // '+'
	if (i == 5)
		return float2(31744.0, 31.0); // '='
	if (i == 6)
		return float2(571392.0, 465.0); // 'o'
	if (i == 7)
		return float2(139875.0, 25378.0); // '%'
	if (i == 8)
		return float2(571392.0, 14399.0); // 'e'
	if (i == 9)
		return float2(575022.0, 14897.0); // 'O'
	if (i == 10)
		return float2(476718.0, 14897.0); // '8'
	if (i == 11)
		return float2(710513.0, 17969.0); // 'M'
	if (i == 12)
		return float2(359754.0, 10591.0); // '#'
	return float2(718382.0, 30781.0); // '@'
}

// Ink (0 or 1) of a glyph at a point of its 6x8 box.
float glyph_ink(float2 bits, float2 p)
{
	float2 g = floor(p - 0.5);
	if (g.x < 0.0 || g.x > 4.0 || g.y < 0.0 || g.y > 6.0)
		return 0.0;
	float word = g.y < 4.0 ? bits.x : bits.y;
	float idx = (g.y < 4.0 ? g.y : g.y - 4.0) * 5.0 + g.x;
	float q = floor((word + 0.5) / exp2(idx));
	return q - 2.0 * floor(q * 0.5);
}

float4 PSAscii(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	float2 pix = uv * uv_size;
	float4 src = fx_input(uv);

	float2 cell = float2(max(rt_ascii_size, 2.0), max(rt_ascii_size, 2.0) * 4.0 / 3.0);
	float2 origin = floor(pix / cell) * cell;

	// Average of the cell (4x4 bilinear taps).
	float4 avg = float4(0.0, 0.0, 0.0, 0.0);
	for (int j = 0; j < 4; j++) {
		for (int i = 0; i < 4; i++) {
			float2 p = origin + (float2(float(i), float(j)) + 0.5) * 0.25 * cell;
			float4 t = fx_input(p / uv_size);
			avg += float4(t.rgb * t.a, t.a);
		}
	}
	avg /= 16.0;
	float3 col = avg.a > 1e-4 ? avg.rgb / avg.a : float3(0.0, 0.0, 0.0);

	// Brightness picks the glyph.
	float lum = saturate(luma(col));
	int gi = int(min(floor(lum * GLYPH_COUNT), GLYPH_COUNT - 1.0));
	float2 bits = glyph_bits(gi);

	// Anti-aliased ink: 4 rotated-grid sub-samples of the glyph box.
	float2 box = (pix - origin) / cell * float2(6.0, 8.0);
	float2 fw = float2(6.0, 8.0) / cell; // glyph px per screen px
	float ink = glyph_ink(bits, box + float2(0.125, 0.375) * fw - 0.25 * fw);
	ink += glyph_ink(bits, box + float2(0.375, -0.125) * fw - 0.25 * fw);
	ink += glyph_ink(bits, box + float2(-0.125, -0.375) * fw + 0.25 * fw);
	ink += glyph_ink(bits, box + float2(-0.375, 0.125) * fw + 0.25 * fw);
	ink *= 0.25;

	float3 fg;
	float3 bg = rt_ascii_bg_color.rgb;
	float bga = rt_ascii_bg_color.a;
	if (rt_ascii_mode == 1) {
		fg = float3(1.0, 1.0, 1.0);
		bg = float3(0.0, 0.0, 0.0);
		bga = 1.0;
	} else if (rt_ascii_mode == 2) {
		fg = rt_ascii_color.rgb;
	} else {
		// The cell's color at full brightness: density already shows
		// how bright it is.
		float mx = max(col.r, max(col.g, col.b));
		fg = mx > 1e-4 ? col / mx : float3(0.0, 0.0, 0.0);
		fg = lerp(col, fg, 0.75);
	}
	float fga = rt_ascii_mode == 2 ? rt_ascii_color.a : 1.0;

	// Straight alpha "over" of glyph on background, then the cell's alpha.
	float a_out = ink * fga + bga * (1.0 - ink * fga);
	float3 rgb = a_out > 1e-5 ? (fg * ink * fga + bg * bga * (1.0 - ink * fga)) / a_out : bg;
	float4 ascii = float4(rgb, a_out * saturate(avg.a));

	float k = saturate(rt_ascii / 100.0);
	float4 o = float4(lerp(src.rgb, ascii.rgb, k), lerp(src.a, ascii.a, k));
	return fx_output(o, v_in.uv);
}

/* ---------------------------------------------------------------------
 * Retro palettes: the two nearest palette colors in Oklab, mixed by an
 * ordered (Bayer) or blue noise threshold in linear light so the pattern
 * averages to the right brightness.
 * ------------------------------------------------------------------- */

float bayer(float2 p, float levels)
{
	float v = 0.0;
	float n = 1.0;
	for (int k = 0; k < 3; k++) {
		if (float(k) < levels) {
			float x = floor(p.x / exp2(float(k)));
			float y = floor(p.y / exp2(float(k)));
			x -= 2.0 * floor(x * 0.5);
			y -= 2.0 * floor(y * 0.5);
			float xr = abs(x - y); // x xor y
			v += (2.0 * xr + y) * exp2(2.0 * (levels - 1.0 - float(k)));
			n *= 4.0;
		}
	}
	return (v + 0.5) / n;
}

void pal_test(float4 p, float3 lab, float3 wt, inout float d1, inout float d2, inout float3 c1, inout float3 c2)
{
	float3 dv = p.xyz - lab;
	float d = dot(dv * dv, wt) + (1.0 - p.w) * 1e6;
	if (d < d1) {
		d2 = d1;
		c2 = c1;
		d1 = d;
		c1 = p.xyz;
	} else if (d < d2) {
		d2 = d;
		c2 = p.xyz;
	}
}

float4 PSPalette(VertData v_in) : TARGET
{
	float2 pix = v_in.uv * uv_size;
	float ps = max(floor(rt_pal_pixel + 0.5), 1.0);
	float2 block = floor(pix / ps);
	float2 centre = (block + 0.5) * ps;

	float4 c;
	if (ps >= 2.0) {
		float o = ps * 0.25;
		c = fx_input((centre + float2(-o, -o)) / uv_size);
		c += fx_input((centre + float2(o, -o)) / uv_size);
		c += fx_input((centre + float2(-o, o)) / uv_size);
		c += fx_input((centre + float2(o, o)) / uv_size);
		c *= 0.25;
	} else {
		c = fx_input(v_in.uv);
	}

	float3 lab = srgb_to_oklab(c.rgb);
	float3 wt = float3(1.0, 1.0, 1.0);
	if (pal_luma > 0.5) {
		// Brightness only, stretched over the palette's own range.
		lab = float3(lerp(pal_lrange.x, pal_lrange.y, saturate(lab.x)), 0.0, 0.0);
		wt = float3(1.0, 0.0, 0.0);
	}
	float d1 = 1e9;
	float d2 = 1e9;
	float3 c1 = float3(0.0, 0.0, 0.0);
	float3 c2 = float3(0.0, 0.0, 0.0);
	pal_test(pal0, lab, wt, d1, d2, c1, c2);
	pal_test(pal1, lab, wt, d1, d2, c1, c2);
	pal_test(pal2, lab, wt, d1, d2, c1, c2);
	pal_test(pal3, lab, wt, d1, d2, c1, c2);
	pal_test(pal4, lab, wt, d1, d2, c1, c2);
	pal_test(pal5, lab, wt, d1, d2, c1, c2);
	pal_test(pal6, lab, wt, d1, d2, c1, c2);
	pal_test(pal7, lab, wt, d1, d2, c1, c2);
	pal_test(pal8, lab, wt, d1, d2, c1, c2);
	pal_test(pal9, lab, wt, d1, d2, c1, c2);
	pal_test(pal10, lab, wt, d1, d2, c1, c2);
	pal_test(pal11, lab, wt, d1, d2, c1, c2);
	pal_test(pal12, lab, wt, d1, d2, c1, c2);
	pal_test(pal13, lab, wt, d1, d2, c1, c2);
	pal_test(pal14, lab, wt, d1, d2, c1, c2);
	pal_test(pal15, lab, wt, d1, d2, c1, c2);

	float3 result = c1;
	if (rt_pal_dither > 0 && d2 < 1e5) {
		float thr;
		if (rt_pal_dither == 4)
			thr = ign(block);
		else
			thr = bayer(block, float(rt_pal_dither));
		thr = 0.5 + (thr - 0.5) * saturate(rt_pal_strength / 100.0);
		// Where the color sits between the two, in linear light.
		float t;
		if (pal_luma > 0.5) {
			// Luminance is about L^3 in Oklab.
			float y = lab.x * lab.x * lab.x;
			float y1 = c1.x * c1.x * c1.x;
			float y2 = c2.x * c2.x * c2.x;
			t = abs(y2 - y1) > 1e-8 ? saturate((y - y1) / (y2 - y1)) : 0.0;
		} else {
			float3 l = srgb_to_linear(saturate(c.rgb));
			float3 l1 = saturate(oklab_to_linear(c1));
			float3 l2 = saturate(oklab_to_linear(c2));
			float3 seg = l2 - l1;
			float len2 = dot(seg, seg);
			t = len2 > 1e-8 ? saturate(dot(l - l1, seg) / len2) : 0.0;
		}
		result = t > thr ? c2 : c1;
	}
	return fx_output(float4(oklab_to_srgb(result), c.a), v_in.uv);
}

/* ---------------------------------------------------------------------
 * VHS: wobble, rolling tracking band, head switching noise, chroma
 * bleed and delay (YIQ), tape noise and dropouts.
 * ------------------------------------------------------------------- */

float3 rgb_to_yiq(float3 c)
{
	return float3(dot(c, float3(0.299, 0.587, 0.114)), dot(c, float3(0.596, -0.274, -0.322)),
		      dot(c, float3(0.211, -0.523, 0.312)));
}

float3 yiq_to_rgb(float3 c)
{
	return float3(c.x + 0.956 * c.y + 0.621 * c.z, c.x - 0.272 * c.y - 0.647 * c.z,
		      c.x - 1.106 * c.y + 1.703 * c.z);
}

float4 PSVhs(VertData v_in) : TARGET
{
	float k = saturate(rt_vhs / 100.0);
	float2 pix = v_in.uv * uv_size;
	float H = uv_size.y;
	float y = pix.y;
	float row = floor(y);
	float frame = floor(time * 29.97);

	// Wobble: slow horizontal sway plus per-line jitter.
	float wob = rt_vhs_wobble * k;
	float shift = wob * (0.6 * sin(y * 0.031 + time * 2.3) + 0.4 * sin(y * 0.0071 - time * 1.1));
	shift += wob * 0.5 * (hash12(float2(row, frame)) - 0.5);

	// Tracking error: a band rolling down the picture, with large
	// horizontal tearing and snow inside it.
	float tr = saturate(rt_vhs_tracking / 100.0) * k;
	float band = 0.0;
	if (tr > 0.0) {
		float bh = max(H * 0.1, 8.0);
		float pos = frac(time * 0.11) * (H + 2.0 * bh) - bh;
		float d = (y - pos) / bh;
		band = saturate(1.0 - abs(d));
		band = band * band * (3.0 - 2.0 * band);
		float tear = value_noise(float2(y * 0.08, time * 12.0)) - 0.35;
		shift += band * tr * tear * uv_size.x * 0.06;
		// A slow, faint vertical skew of the whole frame.
		shift += tr * 2.0 * sin(time * 0.7 + y / H * 3.0);
	}

	// Head switching: the bottom lines tear sideways.
	float hs = saturate(rt_vhs_head / 100.0) * k;
	float head = 0.0;
	if (hs > 0.0) {
		float hb = max(H * 0.045, 6.0);
		head = saturate((y - (H - hb)) / hb);
		float jitter = hash12(float2(row * 0.37, frame)) - 0.5;
		shift += hs * head * (head * uv_size.x * 0.04 + jitter * 6.0);
	}

	float2 texel = 1.0 / uv_size;
	float2 uv = float2(v_in.uv.x - shift * texel.x, v_in.uv.y);

	// Luma: a little horizontal softening.
	float soft = 0.75 * k + 0.25;
	float4 c0 = fx_input(uv);
	float4 cl = fx_input(uv - float2(soft * texel.x, 0.0));
	float4 cr = fx_input(uv + float2(soft * texel.x, 0.0));
	float Y = dot(c0.rgb * 0.5 + (cl.rgb + cr.rgb) * 0.25, float3(0.299, 0.587, 0.114));
	float alpha = c0.a;

	// Chroma: low-passed and smeared to the right, delayed.
	float bleed = rt_vhs_bleed * k;
	float2 iq = float2(0.0, 0.0);
	float wsum = 0.0;
	for (int i = 0; i < 10; i++) {
		float fi = float(i);
		float w = exp(-fi * 0.35);
		float off = rt_vhs_chroma_shift * k + fi * bleed / 9.0;
		float3 t = fx_input(uv - float2(off * texel.x, 0.0)).rgb;
		iq += rgb_to_yiq(t).yz * w;
		wsum += w;
	}
	iq /= wsum;
	float3 rgb = yiq_to_rgb(float3(Y, iq * (1.0 - 0.15 * k)));

	// Tape noise: fine luma snow plus horizontal streaks / dropouts.
	float nz = saturate(rt_vhs_noise / 100.0) * k;
	float snow = hash12(pix + frame * float2(17.3, 31.7)) - 0.5;
	rgb += snow * (nz * 0.12 + band * tr * 0.5 + head * hs * 0.4);
	float rowh = hash12(float2(floor(y * 0.5), frame + 0.5));
	float streak_p = nz * 0.015 + band * tr * 0.25;
	if (rowh < streak_p) {
		float x0 = hash12(float2(rowh * 91.7, frame)) * uv_size.x;
		float len = (0.02 + 0.2 * hash12(float2(frame, rowh * 13.1))) * uv_size.x;
		float u = (pix.x - x0) / len;
		if (u > 0.0 && u < 1.0) {
			float s = (1.0 - u) * (0.6 + 0.4 * hash12(float2(pix.x, frame)));
			rgb = lerp(rgb, float3(1.0, 1.0, 1.0), s * 0.85);
		}
	}
	return fx_output(float4(saturate(rgb), alpha), v_in.uv);
}

technique Tensor
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSTensor(v_in);
	}
}

technique TensorBlur
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSTensorBlur(v_in);
	}
}

technique Oil
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSOil(v_in);
	}
}

technique Ascii
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSAscii(v_in);
	}
}

technique Palette
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSPalette(v_in);
	}
}

technique Vhs
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSVhs(v_in);
	}
}
