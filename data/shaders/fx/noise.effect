// Spectrum Noise source: animated procedural noise mapped through a
// gradient (lava, plasma, aurora, fog, cells, marble...).
#include "fx-common.effect"

uniform int nz_type;        // 1 value, 2 perlin, 3 simplex, 4 cells, 5 cell edges,
                            // 6 starfield, 7 particles, 8 caustics, 9 truchet, 10 hex grid
uniform int nz_fractal;     // 1 fbm, 2 turbulence, 3 ridged
uniform float nz_scale = 200.0; // px per base cell
uniform int nz_octaves;
uniform float nz_lacunarity = 2.0;
uniform float nz_gain = 50.0;   // %
uniform float nz_warp = 0.0;    // domain warp strength, %
uniform float nz_evolve = 0.2;  // evolution speed
uniform float nz_flow_x = 0.0;  // px / s
uniform float nz_flow_y = 0.0;
uniform float nz_seed = 0.0;
uniform float nz_contrast = 100.0;  // %
uniform float nz_brightness = 0.0;  // %
uniform float nz_aspect = 100.0;    // %
uniform float nz_opacity = 100.0;
// Patterns (types 6-10).
uniform float nz_density = 50.0;   // %, stars / particles per cell
uniform float nz_size = 50.0;      // %, star / particle size, line width
uniform float nz_twinkle = 50.0;   // %, twinkle / flicker / cell pulse
uniform int nz_hex_style;          // 1 cells, 2 edges, 3 cells and edges

float2 grad2(float2 i)
{
	float a = hash12(i + nz_seed * 17.31) * TAU;
	return float2(cos(a), sin(a));
}

// All in [-1, 1].
float n_value(float2 p)
{
	return value_noise(p + nz_seed * 13.7) * 2.0 - 1.0;
}

float n_perlin(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	float a = dot(grad2(i), f);
	float b = dot(grad2(i + float2(1.0, 0.0)), f - float2(1.0, 0.0));
	float c = dot(grad2(i + float2(0.0, 1.0)), f - float2(0.0, 1.0));
	float d = dot(grad2(i + float2(1.0, 1.0)), f - float2(1.0, 1.0));
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y) * 1.4142;
}

float n_simplex(float2 p)
{
	float K1 = 0.366025404;
	float K2 = 0.211324865;
	float2 i = floor(p + (p.x + p.y) * K1);
	float2 a = p - i + (i.x + i.y) * K2;
	float m = step(a.y, a.x);
	float2 o = float2(m, 1.0 - m);
	float2 b = a - o + K2;
	float2 c = a - 1.0 + 2.0 * K2;
	float3 h = max(0.5 - float3(dot(a, a), dot(b, b), dot(c, c)), float3(0.0, 0.0, 0.0));
	float3 n = h * h * h * h * float3(dot(a, grad2(i)), dot(b, grad2(i + o)), dot(c, grad2(i + 1.0)));
	return dot(n, float3(70.0, 70.0, 70.0));
}

// Cell (Voronoi) noise: x = distance to the nearest point, y = second.
float2 n_cells(float2 p, float t)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float f1 = 8.0;
	float f2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			float2 g = float2(float(x), float(y));
			float2 h = hash22(i + g + nz_seed * 7.13);
			float2 o = 0.5 + 0.5 * sin(t + TAU * h);
			float d = length(g + o - f);
			if (d < f1) {
				f2 = f1;
				f1 = d;
			} else if (d < f2) {
				f2 = d;
			}
		}
	}
	return float2(f1, f2);
}

float basis(float2 p, float t, int octave)
{
	// Each octave drifts in its own direction over time ("evolution").
	float a = float(octave) * 2.39996;
	float2 drift = float2(cos(a), sin(a)) * t;
	if (nz_type == 1)
		return n_value(p + drift);
	if (nz_type == 2)
		return n_perlin(p + drift);
	if (nz_type == 4) {
		float2 c = n_cells(p, t * 3.0);
		return saturate(c.x) * 2.0 - 1.0;
	}
	if (nz_type == 5) {
		float2 c = n_cells(p, t * 3.0);
		return saturate((c.y - c.x) * 2.0) * 2.0 - 1.0;
	}
	return n_simplex(p + drift);
}

float fractal(float2 p, float t)
{
	float sum = 0.0;
	float amp = 1.0;
	float norm = 0.0;
	float gain = saturate(nz_gain / 100.0);
	float prev = 1.0;
	for (int o = 0; o < 8; o++) {
		if (o >= nz_octaves)
			break;
		float n = basis(p, t, o);
		if (nz_fractal == 2) {
			n = abs(n) * 2.0 - 1.0;
		} else if (nz_fractal == 3) {
			n = 1.0 - abs(n);
			n = n * n;
			// Ridges sharpen where the previous octave was high.
			float w = n * prev;
			prev = saturate(n);
			n = w * 2.0 - 1.0;
		}
		sum += n * amp;
		norm += amp;
		amp *= gain;
		p = p * nz_lacunarity + float2(17.3, -9.1);
	}
	return sum / max(norm, 1e-4); // [-1, 1]
}

/* Patterns ---------------------------------------------------------------
 * Types 6-10 draw a pattern instead of layered noise. They return a value in
 * [0, 1] that is mapped through the gradient like the noise. `p` is in units
 * of the base scale (after aspect and warp); `px` is the size of one output
 * pixel in those units, for anti-aliasing. Detail Layers, Layer Scale and
 * Layer Strength set the parallax layers of the starfield and particles.
 */

// Point sprites on a jittered grid, one optional point per cell: x = profile
// of the nearest point (0 when none), y = its random brightness.
// Shared by the starfield (sharp, twinkling) and particles (soft, wobbling).
float sprites(float2 p, float px, float layer, float t, float soft)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float density = saturate(nz_density / 100.0);
	float size = saturate(nz_size / 100.0);
	float tw = saturate(nz_twinkle / 100.0);
	float sum = 0.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			float2 g = float2(float(x), float(y));
			float2 id = i + g + layer * 37.17 + nz_seed * 11.31;
			float h = hash12(id);
			if (h >= density)
				continue;
			float2 r = hash22(id + 3.7);
			float b = hash12(id + 9.1);
			float2 o = r;
			if (soft > 0.5) {
				// Particles wobble around their place.
				float a = TAU * b;
				o = 0.2 + 0.6 * r + 0.25 * float2(sin(t * (0.7 + b) + a), cos(t * (0.9 + r.x) + 2.0 * a));
			}
			float d = length(g + o - f);
			float v;
			if (soft > 0.5) {
				// Particle: a disc with a soft (out of focus) edge.
				float rad = (0.04 + 0.2 * size) * (0.5 + 0.5 * r.y);
				float blur = rad * 0.6 + px;
				v = 1.0 - smoothstep(rad - blur, rad + px, d);
				v *= 0.35 + 0.65 * b;
				v *= 1.0 - tw * 0.6 * (0.5 + 0.5 * sin(t * (1.3 + 2.0 * r.x) + TAU * r.y));
			} else {
				// Star: a pixel-sized core plus a faint halo; most stars are
				// dim, a few bright.
				float bright = b * b * 0.8 + 0.2;
				float rad = max(px * (0.6 + 2.2 * size) * (0.4 + 0.6 * bright), px * 0.5);
				float q = d / rad;
				v = exp(-q * q) + 0.12 * bright * exp(-q * 0.6);
				float speed = 1.0 + 3.0 * r.x;
				float twinkle = 0.5 + 0.5 * sin(t * speed * 6.0 + TAU * r.y);
				v *= bright * (1.0 - tw * twinkle * twinkle);
			}
			sum += v;
		}
	}
	return sum;
}

// Parallax layers of sprites: layer k is lacunarity^k times smaller, moves
// with 1 / lacunarity^k of the flow (nearer layers pass faster) and is
// dimmed by the layer strength.
float sprite_layers(float2 p, float2 flow_back, float px, float t, float soft, float cell)
{
	float sum = 0.0;
	float amp = 1.0;
	float gain = saturate(nz_gain / 100.0);
	float lac = max(nz_lacunarity, 1.01);
	float k = 1.0;
	for (int o = 0; o < 8; o++) {
		if (o >= nz_octaves)
			break;
		float depth = 1.0 / k;
		// The global flow moves every layer at full speed: take back the
		// part farther layers don't move.
		float2 q = (p + flow_back * (1.0 - depth)) * k / cell + float2(float(o) * 13.7, float(o) * 7.3);
		sum += amp * sprites(q, px * k / cell, float(o), t + float(o) * 3.1, soft);
		amp *= gain;
		k *= lac;
	}
	return saturate(sum);
}

// Water caustics: the bright, wobbling net of light under waves. Each layer
// is the edge network of moving cells, bent by a smooth warp; two layers
// drifting apart add up to the brighter knots where lines cross.
float caustic_layer(float2 p, float t, float w)
{
	p += 0.3 * float2(n_simplex(p * 0.6 + float2(t * 0.4, 0.0)), n_simplex(p * 0.6 + float2(9.1, -t * 0.4)));
	float2 c = n_cells(p, t * 2.0);
	float e = c.y - c.x;
	float l = saturate(1.0 - e / w);
	return l * l * l;
}

float caustics(float2 p, float px, float t)
{
	float w = 0.08 + 0.4 * saturate(nz_size / 100.0) + px * 2.0;
	float a = caustic_layer(p, t, w);
	float b = caustic_layer(p * 1.31 + float2(3.7, 1.9), -t * 0.8 + 5.0, w * 1.2);
	return saturate(0.65 * a + 0.5 * b + 0.6 * a * b);
}

// Truchet tiles: quarter circle arcs around two opposite corners of every
// cell, randomly flipped, drawn as shaded tubes. Over time tiles swap to the
// other orientation now and then (evolution speed), fading across.
float truchet_arcs(float2 f, float flip, float px)
{
	if (flip > 0.5)
		f.x = 1.0 - f.x;
	float d = min(abs(length(f) - 0.5), abs(length(f - 1.0) - 0.5));
	float w = 0.03 + 0.2 * saturate(nz_size / 100.0);
	float cov = 1.0 - smoothstep(w - px * 0.5, w + px * 0.5, d);
	float tube = sqrt(saturate(1.0 - (d / w) * (d / w)));
	return cov * (0.25 + 0.75 * tube);
}

float truchet(float2 p, float px, float t)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float h = hash12(i + nz_seed * 5.77);
	// Each tile changes at its own moments.
	float phase = t * (0.5 + h) + h * 7.0;
	float k = floor(phase);
	float flip0 = step(0.5, hash12(i + k * 1.618 + nz_seed * 3.1));
	float flip1 = step(0.5, hash12(i + (k + 1.0) * 1.618 + nz_seed * 3.1));
	float fade = smoothstep(0.85, 1.0, frac(phase));
	float a = truchet_arcs(f, flip0, px);
	if (flip1 == flip0)
		return a;
	return lerp(a, truchet_arcs(f, flip1, px), fade);
}

// Hexagonal grid: per cell values that pulse over time and/or glowing edges.
float hex_grid(float2 p, float px, float t)
{
	float2 s = float2(1.0, 1.7320508);
	float4 hc = floor(float4(p, p - float2(0.5, 1.0)) / s.xyxy) + 0.5;
	float4 h = float4(p - hc.xy * s, p - (hc.zw + 0.5) * s);
	bool first = dot(h.xy, h.xy) < dot(h.zw, h.zw);
	float2 local = first ? h.xy : h.zw;
	float2 id = first ? hc.xy : hc.zw + 0.5;
	float2 a = abs(local);
	// 0 at the centre, 0.5 on the edge.
	float hd = max(dot(a, float2(0.5, 0.8660254)), a.x);
	float edge = 0.5 - hd;

	float r = hash12(id + nz_seed * 4.37);
	float r2 = hash12(id + 17.3 + nz_seed * 2.11);
	float tw = saturate(nz_twinkle / 100.0);
	// A slow wave across the grid plus each cell's own pulse.
	float wave = 0.5 + 0.5 * sin(t * 2.0 - dot(id * s, float2(0.35, 0.2)));
	float pulse = 0.5 + 0.5 * sin(t * (1.5 + 2.0 * r2) + TAU * r);
	float cell = lerp(r, lerp(wave, pulse, 0.5), tw);

	float w = 0.01 + 0.08 * saturate(nz_size / 100.0);
	float line = 1.0 - smoothstep(w - px * 0.5, w + px * 0.5, edge);
	// Edges glow a little into the cells and brighten with the pulse.
	float glow = exp(-max(edge - w, 0.0) / max(w * 2.0, px));
	float edge_v = saturate(line + 0.35 * glow) * lerp(1.0, 0.4 + 0.6 * pulse, tw);

	if (nz_hex_style == 1)
		return cell * (1.0 - line * 0.6);
	if (nz_hex_style == 2)
		return edge_v;
	return max(cell * 0.6 * (1.0 - line), edge_v);
}

float pattern(float2 p, float2 flow_back, float px, float t)
{
	if (nz_type == 6)
		return sprite_layers(p, flow_back, px, t, 0.0, 0.1);
	if (nz_type == 7)
		return sprite_layers(p, flow_back, px, t, 1.0, 0.25);
	if (nz_type == 8)
		return caustics(p * 3.0, px * 3.0, t);
	if (nz_type == 9)
		return truchet(p * 4.0, px * 4.0, t);
	return hex_grid(p * 5.0, px * 5.0, t);
}

float4 PSDraw(VertData v_in) : TARGET
{
	float2 pix = v_in.uv * uv_size - float2(nz_flow_x, nz_flow_y) * time;
	float aspect = max(nz_aspect / 100.0, 0.01);
	float2 p = pix / max(nz_scale, 1.0) * float2(1.0 / sqrt(aspect), sqrt(aspect));
	float t = time * nz_evolve;

	// Patterns take a gentler warp (the sprites none: it would smear them).
	float warp = 1.0;
	if (nz_type == 6 || nz_type == 7)
		warp = 0.0;
	else if (nz_type == 8)
		warp = 0.1;
	else if (nz_type >= 9)
		warp = 0.025;
	if (nz_warp * warp > 0.0) {
		float k = nz_warp / 100.0 * 4.0 * warp;
		float2 q = float2(fractal(p + float2(0.0, 0.0), t), fractal(p + float2(5.2, 1.3), t));
		p += k * q;
	}

	float v;
	if (nz_type >= 6) {
		float2 flow_back = float2(nz_flow_x, nz_flow_y) * time / max(nz_scale, 1.0) *
				   float2(1.0 / sqrt(aspect), sqrt(aspect));
		v = pattern(p, flow_back, 1.0 / max(nz_scale, 1.0), t);
	} else {
		v = fractal(p, t) * 0.5 + 0.5;
	}
	v = (v - 0.5) * (nz_contrast / 100.0) + 0.5 + nz_brightness / 100.0;
	float4 c = gradient_sample(saturate(v));
	c.a *= saturate(nz_opacity / 100.0);
	return fx_output(c, v_in.uv);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDraw(v_in);
	}
}
