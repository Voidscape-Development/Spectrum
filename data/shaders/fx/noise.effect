// Spectrum Noise source: animated procedural noise mapped through a
// gradient (lava, plasma, aurora, fog, cells, marble...).
#include "fx-common.effect"

uniform int nz_type = 3;        // 1 value, 2 perlin, 3 simplex, 4 cells, 5 cell edges
uniform int nz_fractal = 1;     // 1 fbm, 2 turbulence, 3 ridged
uniform float nz_scale = 200.0; // px per base cell
uniform int nz_octaves = 4;
uniform float nz_lacunarity = 2.0;
uniform float nz_gain = 50.0;   // %
uniform float nz_warp = 0.0;    // domain warp strength, %
uniform float nz_evolve = 0.2;  // evolution speed
uniform float nz_flow_x = 0.0;  // px / s
uniform float nz_flow_y = 0.0;
uniform float nz_seed = 0.0;
uniform float nz_contrast = 100.0;  // %
uniform float nz_brightness = 0.0;  // %
uniform float nz_aspect = 100.0;    // %
uniform float nz_opacity = 100.0;

float2 grad2(float2 i)
{
	float a = hash12(i + nz_seed * 17.31) * TAU;
	return float2(cos(a), sin(a));
}

// All in [-1, 1].
float n_value(float2 p)
{
	return value_noise(p + nz_seed * 13.7) * 2.0 - 1.0;
}

float n_perlin(float2 p)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
	float a = dot(grad2(i), f);
	float b = dot(grad2(i + float2(1.0, 0.0)), f - float2(1.0, 0.0));
	float c = dot(grad2(i + float2(0.0, 1.0)), f - float2(0.0, 1.0));
	float d = dot(grad2(i + float2(1.0, 1.0)), f - float2(1.0, 1.0));
	return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y) * 1.4142;
}

float n_simplex(float2 p)
{
	float K1 = 0.366025404;
	float K2 = 0.211324865;
	float2 i = floor(p + (p.x + p.y) * K1);
	float2 a = p - i + (i.x + i.y) * K2;
	float m = step(a.y, a.x);
	float2 o = float2(m, 1.0 - m);
	float2 b = a - o + K2;
	float2 c = a - 1.0 + 2.0 * K2;
	float3 h = max(0.5 - float3(dot(a, a), dot(b, b), dot(c, c)), float3(0.0, 0.0, 0.0));
	float3 n = h * h * h * h * float3(dot(a, grad2(i)), dot(b, grad2(i + o)), dot(c, grad2(i + 1.0)));
	return dot(n, float3(70.0, 70.0, 70.0));
}

// Cell (Voronoi) noise: x = distance to the nearest point, y = second.
float2 n_cells(float2 p, float t)
{
	float2 i = floor(p);
	float2 f = frac(p);
	float f1 = 8.0;
	float f2 = 8.0;
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			float2 g = float2(float(x), float(y));
			float2 h = hash22(i + g + nz_seed * 7.13);
			float2 o = 0.5 + 0.5 * sin(t + TAU * h);
			float d = length(g + o - f);
			if (d < f1) {
				f2 = f1;
				f1 = d;
			} else if (d < f2) {
				f2 = d;
			}
		}
	}
	return float2(f1, f2);
}

float basis(float2 p, float t, int octave)
{
	// Each octave drifts in its own direction over time ("evolution").
	float a = float(octave) * 2.39996;
	float2 drift = float2(cos(a), sin(a)) * t;
	if (nz_type == 1)
		return n_value(p + drift);
	if (nz_type == 2)
		return n_perlin(p + drift);
	if (nz_type == 4) {
		float2 c = n_cells(p, t * 3.0);
		return saturate(c.x) * 2.0 - 1.0;
	}
	if (nz_type == 5) {
		float2 c = n_cells(p, t * 3.0);
		return saturate((c.y - c.x) * 2.0) * 2.0 - 1.0;
	}
	return n_simplex(p + drift);
}

float fractal(float2 p, float t)
{
	float sum = 0.0;
	float amp = 1.0;
	float norm = 0.0;
	float gain = saturate(nz_gain / 100.0);
	float prev = 1.0;
	for (int o = 0; o < 8; o++) {
		if (o >= nz_octaves)
			break;
		float n = basis(p, t, o);
		if (nz_fractal == 2) {
			n = abs(n) * 2.0 - 1.0;
		} else if (nz_fractal == 3) {
			n = 1.0 - abs(n);
			n = n * n;
			// Ridges sharpen where the previous octave was high.
			float w = n * prev;
			prev = saturate(n);
			n = w * 2.0 - 1.0;
		}
		sum += n * amp;
		norm += amp;
		amp *= gain;
		p = p * nz_lacunarity + float2(17.3, -9.1);
	}
	return sum / max(norm, 1e-4); // [-1, 1]
}

float4 PSDraw(VertData v_in) : TARGET
{
	float2 pix = v_in.uv * uv_size - float2(nz_flow_x, nz_flow_y) * time;
	float aspect = max(nz_aspect / 100.0, 0.01);
	float2 p = pix / max(nz_scale, 1.0) * float2(1.0 / sqrt(aspect), sqrt(aspect));
	float t = time * nz_evolve;

	if (nz_warp > 0.0) {
		float k = nz_warp / 100.0 * 4.0;
		float2 q = float2(fractal(p + float2(0.0, 0.0), t), fractal(p + float2(5.2, 1.3), t));
		p += k * q;
	}

	float v = fractal(p, t) * 0.5 + 0.5;
	v = (v - 0.5) * (nz_contrast / 100.0) + 0.5 + nz_brightness / 100.0;
	float4 c = gradient_sample(saturate(v));
	c.a *= saturate(nz_opacity / 100.0);
	return fx_output(c, v_in.uv);
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSDraw(v_in);
	}
}
